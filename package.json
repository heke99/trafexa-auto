{
  "name": "trafexa-dealer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:signing": "node tests/signing-flow/verify-all.mjs",
    "test:setup": "node scripts/setup-test-dependencies.mjs",
    "pretest": "node scripts/prepare-test-runtime.mjs",
    "test:archive-restore": "node --test --test-concurrency=2 tests/contract-backup-roundtrip.test.mjs tests/contract-archive-package.test.mjs tests/contract-archive-package-cli.test.mjs tests/native-contract-archive-package-route.test.mjs",
    "local:start": "node scripts/local-supabase.mjs start",
    "local:stop": "node scripts/local-supabase.mjs stop",
    "local:status": "node scripts/local-supabase.mjs status",
    "local:reset": "node scripts/local-supabase.mjs db reset --yes",
    "local:bootstrap": "node scripts/local-bootstrap.mjs",
    "local:verify": "node scripts/verify-environment.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "test:matrix": "node scripts/test-matrix.mjs list",
    "test:database": "node scripts/test-matrix.mjs database",
    "test:native": "node scripts/test-matrix.mjs native",
    "verify:reviewed-environment": "node scripts/verify-reviewed-environment.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "svix": "2.8.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}

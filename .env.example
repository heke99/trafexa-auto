# Local Supabase only. `npm run local:bootstrap` writes generated local keys into a new .env.local.
# Do not paste a hosted production key into a development checkout.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TRAFEXA_DEPLOYMENT_TARGET=local

# Server only: use the local secret/service_role key from the isolated local stack.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Separate stable random secrets per environment. Never reuse a provider/API key.
# Generate locally: openssl rand -hex 32
UPLOADED_PDF_LINK_SECRET=

# All real outbound transports start disabled. Auth uses the local Mailpit inbox.
TRANSACTIONAL_EMAIL_ENABLED=false
CONTRACT_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_DOMAIN_VERIFIED=false
RESEND_API_KEY=
ADVERTISING_INVOICE_EMAIL_ENABLED=false
RESEND_WEBHOOK_SECRET=
BLOCKET_DISPATCH_ENABLED=false
INTERNAL_ADVERTISING_SECRET=
BLOCKET_GROUP_TOKENS_JSON=

# Server-only account-invitation encryption keyring (separate from Supabase keys).
# Generate a random 32-byte base64url key; JSON map: {"local-v1":"<key>"}.
ACCOUNT_INVITATION_ACTIVE_KEY_ID=
ACCOUNT_INVITATION_ENCRYPTION_KEYS=
# Optional JSON array of previously used v1 secrets, only for explicit legacy recovery.
ACCOUNT_INVITATION_LEGACY_SECRETS=

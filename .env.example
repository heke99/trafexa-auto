NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://trafexa.com
NEXT_PUBLIC_APP_URL=https://app.trafexa.com

# Server-only registration of verified offer PDF archives. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Business transactional emails. Auth SMTP remains configured separately in Supabase.
# Enable only after trafexa.com is verified with the provider; server-only credentials.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_DOMAIN_VERIFIED=false
RESEND_API_KEY=

# Explicitly reviewed invoice/credit email. This gate is separate from other business events.
ADVERTISING_INVOICE_EMAIL_ENABLED=false
# Signing secret for /api/webhooks/resend/invoice-email. Never expose in NEXT_PUBLIC_.
RESEND_WEBHOOK_SECRET=

# Blocket dispatch is an explicit server-only opt-in, separate from public Trafexa stores.
BLOCKET_DISPATCH_ENABLED=false
INTERNAL_ADVERTISING_SECRET=
# JSON map from reviewed credentialReference labels to Blocket JWTs; never use NEXT_PUBLIC_.
BLOCKET_GROUP_TOKENS_JSON=
# SUPABASE_SECRET_KEY above is used by the internal worker; legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=
